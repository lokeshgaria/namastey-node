# .gitattributes

# Default — normalize all text files to LF
* text=auto eol=lf

# Shell scripts — always LF (critical for husky)
*.sh text eol=lf
.husky/* text eol=lf

# Windows specific files — keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.pdf binary